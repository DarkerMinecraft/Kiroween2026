# ---------------------------------------------------------------------------
# Senior Call Shield — environment variables
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored; never commit real secrets. This example lists every
# variable the app reads, with safe placeholder values.
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres) ----------------------------------------------
# Prisma connection string used for both runtime queries (src/lib/prisma.ts)
# and migrations (prisma7.config.ts).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Better Auth ------------------------------------------------------------
# Random secret used to sign session tokens/cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Base URL of the app (server-side).
BETTER_AUTH_URL="http://localhost:3000"
# Base URL exposed to the browser for the Better Auth client. Usually the same
# as BETTER_AUTH_URL.
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# --- App ---------------------------------------------------------------------
# Public base URL used to build webhook/callback URLs (e.g. the SignalWire
# inbound-handler URL). Falls back to BETTER_AUTH_URL when unset.
APP_BASE_URL="http://localhost:3000"

# --- Stripe billing ----------------------------------------------------------
# Secret API key for the Stripe account.
STRIPE_SECRET_KEY="sk_test_xxx"
# Signing secret for the billing webhook endpoint (/api/billing/webhook).
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Price id for the per-senior Family plan.
STRIPE_FAMILY_PRICE_ID="price_family_xxx"
# Price id for the per-member Partner plan.
STRIPE_PARTNER_PRICE_ID="price_partner_xxx"
# Optional: monthly Family price in cents, used for display/estimates.
STRIPE_FAMILY_PRICE_CENTS="1499"

# --- SignalWire telephony ----------------------------------------------------
SIGNALWIRE_PROJECT_ID="your-signalwire-project-id"
SIGNALWIRE_API_TOKEN="your-signalwire-api-token"
# Your SignalWire space URL, e.g. example.signalwire.com
SIGNALWIRE_SPACE_URL="example.signalwire.com"
# Shared secret that guards the telephony webhook routes
# (/api/telephony/inbound and /api/telephony/report).
TELEPHONY_WEBHOOK_SECRET="replace-with-a-shared-secret"

# --- Misc --------------------------------------------------------------------
# Default region for parsing/normalizing phone numbers to E.164. Defaults to US.
DEFAULT_PHONE_REGION="US"
# Shared secret that authorizes the retention cron endpoint (/api/cron/retention).
CRON_SECRET="replace-with-a-shared-secret"
